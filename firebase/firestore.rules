rules_version = '2';

// ===============================================================
// Guagua de pan · reglas de Firestore (prototipo, para revisar)
// ===============================================================
//
// Modelo de datos que suponen estas reglas
//
// Colección: guaguas
// ID: 7 letras y números al azar, lo genera la app (es el enlace corto; los viejos tienen 20)
// Campos:
//   - dueno: string (obligatorio, inmutable) uid de quien la comparte (su cuenta, o una sesión anónima si no entró)
//   - receta: string (obligatorio, 1–12000) la guagua codificada, igual que en el enlace largo
//   - creada: timestamp (obligatorio) hora del servidor
//   - v: int (obligatorio, 3) versión de la receta
// Toda guagua compartida se guarda aquí (con o sin cuenta): de aquí saldrá la galería.
// Acceso: cualquiera la abre por su ID, porque quien recibe un regalo puede no tener
// cuenta. Nadie puede listar la colección. Su dueño le puede cambiar la receta (el enlace
// sigue siendo el mismo) o borrarlo.
//
// Colección: galeria
// ID: automático de Firestore
// Campos: dueno (uid, cuenta o anónimo), receta (sin p, d, m: solo la guagua),
//   nombre (0–40), molde (1–20), firma (opcional, 1–24: cómo firma quien la compartió),
//   creada (hora del servidor), v (3)
// Acceso: cualquiera la lista (de a 48 como mucho) y la abre; nadie la edita;
// su autor la puede quitar. La app la lee con orderBy('creada', 'desc').
//
// Colección: usuarios/{uid}/vitrina
// ID: lo genera la app
// Campos:
//   - tipo: string (obligatorio, 'mia' | 'recibida')
//   - receta: string (obligatorio, 1–12000)
//   - guagua: string (opcional, 1–40) ID del regalo en /guaguas, si lo hay
//   - fecha: timestamp (obligatorio) hora del servidor
// Acceso: solo su dueño. La app la lee con orderBy('fecha', 'desc') y limit(80).
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── ayudas ─────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function validString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    // ─── validadores ────────────────────────────────────────
    function isValidGuagua(data) {
      return data.keys().hasAll(['dueno', 'receta', 'creada', 'v'])
        && data.keys().hasOnly(['dueno', 'receta', 'creada', 'v'])
        && data.dueno is string
        && validString(data.receta, 1, 12000)
        && data.creada is timestamp
        && data.v is int && data.v == 3;
    }
    function isValidGaleria(data) {
      return data.keys().hasAll(['dueno', 'receta', 'nombre', 'molde', 'creada', 'v'])
        && data.keys().hasOnly(['dueno', 'receta', 'nombre', 'molde', 'firma', 'creada', 'v'])
        && data.dueno is string
        && validString(data.receta, 1, 12000)
        && validString(data.nombre, 0, 40)
        && (!('firma' in data) || validString(data.firma, 1, 24))
        && validString(data.molde, 1, 20)
        && data.creada is timestamp
        && data.v is int && data.v == 3;
    }
    function isValidVitrina(data) {
      return data.keys().hasAll(['tipo', 'receta', 'fecha'])
        && data.keys().hasOnly(['tipo', 'receta', 'guagua', 'fecha'])
        && data.tipo in ['mia', 'recibida']
        && validString(data.receta, 1, 12000)
        && (!('guagua' in data) || validString(data.guagua, 1, 40))
        && data.fecha is timestamp;
    }

    // ─── los regalos ────────────────────────────────────────
    match /guaguas/{guaguaId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated()
        && guaguaId.matches('^[A-Za-z0-9]{6,40}$')
        && isValidGuagua(request.resource.data)
        && request.resource.data.dueno == request.auth.uid
        && request.resource.data.creada == request.time;
      // su dueño puede cambiarle solo la receta (nombre, dedicatoria, mensaje): el enlace es el mismo
      allow update: if isAuthenticated()
        && resource.data.dueno == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receta'])
        && validString(request.resource.data.receta, 1, 12000);
      allow delete: if isAuthenticated() && resource.data.dueno == request.auth.uid;
    }

    // ─── la galería: las que su autor decidió mostrar ────────
    // La guagua, su nombre y la firma de quien la compartió (la receta llega sin
    // para quién, de quién ni mensaje). Cualquiera la ve; nadie la edita; su autor la puede quitar.
    match /galeria/{itemId} {
      allow get: if true;
      allow list: if request.query.limit <= 48;
      allow create: if isAuthenticated()
        && isValidGaleria(request.resource.data)
        && request.resource.data.dueno == request.auth.uid
        && request.resource.data.creada == request.time;
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.dueno == request.auth.uid;
    }

    // ─── la vitrina de cada persona ─────────────────────────
    match /usuarios/{userId}/vitrina/{itemId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidVitrina(request.resource.data)
        && request.resource.data.fecha == request.time;
      allow delete: if isOwner(userId);
    }

    // todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
